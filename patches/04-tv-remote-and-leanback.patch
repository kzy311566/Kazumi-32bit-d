+/// Makes a TV remote's centre button activate the focused control.
+///
+/// Flutter maps `Enter`, `Space` and `GameButtonA` to [ActivateIntent], but a
+/// remote's OK/centre press arrives as [LogicalKeyboardKey.select], which has no
+/// default activation mapping. Without this, D-pad focus could be moved around
+/// the UI and nothing could be pressed.
+///
+/// An early key handler is used rather than a `Shortcuts`/`SingleActivator`
+/// mapping: that is the pattern already proven by `PlayerKeyboardShortcuts`, and
+/// it avoids depending on how the shortcut machinery treats the `select` key
+/// across engine versions. The intent is still dispatched with [Actions.invoke]
+/// on the focused context, so the focused control's own `onPressed` handles the
+/// press instead of a global override.
+class _TvRemoteActivationScope extends StatefulWidget {
+  const _TvRemoteActivationScope({required this.child});
+
+  final Widget child;
+
+  @override
+  State<_TvRemoteActivationScope> createState() =>
+      _TvRemoteActivationScopeState();
+}
+
+class _TvRemoteActivationScopeState extends State<_TvRemoteActivationScope> {
+  @override
+  void initState() {
+    super.initState();
+    FocusManager.instance.addEarlyKeyEventHandler(_onKey);
+  }
+
+  @override
+  void dispose() {
+    FocusManager.instance.removeEarlyKeyEventHandler(_onKey);
+    super.dispose();
+  }
+
+  KeyEventResult _onKey(KeyEvent event) {
+    if (event is! KeyDownEvent) return KeyEventResult.ignored;
+    if (!TvSupport.isUnmappedActivateKey(event.logicalKey)) {
+      return KeyEventResult.ignored;
+    }
+    // Inside a text field the key belongs to the field and its on-screen
+    // keyboard, so leave it alone.
+    final focusContext = FocusManager.instance.primaryFocus?.context;
+    if (focusContext == null) return KeyEventResult.ignored;
+    if (focusContext.widget is EditableText) return KeyEventResult.ignored;
+    if (focusContext.findAncestorWidgetOfExactType<EditableText>() != null) {
+      return KeyEventResult.ignored;
+    }
+    Actions.invoke(focusContext, ActivateIntent());
+    return KeyEventResult.handled;
+  }
+
+  @override
+  Widget build(BuildContext context) => widget.child;
+}
